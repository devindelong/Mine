{
   "version": 6,
   "cmakeMinimumRequired": {
      "major": 3,
      "minor": 25
   },

   "configurePresets": [
      {
         "name": "base",
         "hidden": true,
         "generator": "Ninja",
         "binaryDir": "${sourceDir}/build/${presetName}",
         "cacheVariables": {
            "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
            "CMAKE_COLOR_DIAGNOSTICS": "ON"
         }
      },
      {
         "name": "debug",
         "inherits": "base",
         "displayName": "Debug",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Debug"
         }
      },
      {
         "name": "release",
         "inherits": "base",
         "displayName": "Release",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "Release"
         }
      },
      {
         "name": "release-debug",
         "inherits": "base",
         "displayName": "RelWithDebInfo",
         "cacheVariables": {
            "CMAKE_BUILD_TYPE": "RelWithDebInfo"
         }
      }
   ],

   "buildPresets": [
      {
         "name": "debug",
         "configurePreset": "debug"
      },
      {
         "name": "release",
         "configurePreset": "release"
      },
      {
         "name": "release-debug",
         "configurePreset": "release-debug"
      }
   ],

   "testPresets": [
      {
         "name": "base",
         "hidden": true,
         "output": {
            "outputOnFailure": true
         }
      },
      {
         "name": "release",
         "inherits": "base",
         "configurePreset": "release"
      },
      {
         "name": "debug",
         "inherits": "base",
         "configurePreset": "debug"
      },
      {
         "name": "release-debug",
         "inherits": "base",
         "configurePreset": "release-debug"
      }
   ]
}
